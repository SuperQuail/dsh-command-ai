{
  "name": "dsh-command-ai",
  "version": "0.5.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.js",
  "description": "CommandCode provider bundle for DSH: configurable model capabilities, live model discovery and custom models.",
  "keywords": ["dsh", "cordis", "commandcode", "llm", "provider"],
  "exports": { ".": "./src/index.js", "./client": "./client.js", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json" },
  "files": ["src", "client.js", "cordis.patch.yml", "locale", "README.md", "install.ps1"],
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.7-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "@earendil-works/pi-ai": "0.85.1"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/build-client.mjs --check && node scripts/check-package.mjs",
    "test": "node --test tests/provider.test.js tests/installer.test.js tests/client.test.js tests/capabilities.test.js tests/discovery.test.js",
    "test:adapter": "node --import ./tests/host-imports.js --test tests/adapter.test.js",
    "install:plugin": "pwsh -NoProfile -File ./install.ps1"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings-models", "@deepseek-ai/dsh-api-remotes"]
    }
  }
}
